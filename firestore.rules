rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /claudeAccess/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /adminAlerts/{doc} {
      allow read: if request.auth != null
        && request.auth.token.email == 'bos@eriko.ph';
      allow write: if false;
    }

    match /foods/{foodId} {
      function isFoodAdmin() {
        return request.auth.token.email == 'bos@eriko.ph'
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true
          );
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.addedBy == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.addedBy == resource.data.addedBy
        && (resource.data.addedBy == request.auth.uid || isFoodAdmin());
      allow delete: if request.auth != null
        && (resource.data.addedBy == request.auth.uid || isFoodAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
